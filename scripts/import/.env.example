# Copy to scripts/import/.env (git-ignored). Used ONLY by the local importer, never by an app.
# Project Settings > API: the project URL and the SECRET (service_role) key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Authentication > Users: your user's UID. Every imported row is written with it.
LEDGR_USER_ID=

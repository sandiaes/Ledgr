# Copy to scripts/prices/.env (git-ignored). Used ONLY by the local price script, never by an app.
# Project Settings > API: the project URL and the SECRET (service_role) key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Authentication > Users: your user's UID. Every row is written with it.
LEDGR_USER_ID=
# Price providers (docs/prices.md). The same keys go into Supabase secrets for the daily jobs.
TIINGO_API_KEY=
ALPHAVANTAGE_API_KEY=
# Optional: raises OpenFIGI's limits; symbol resolution works without it.
OPENFIGI_API_KEY=
# Optional: days before a price / a certificado value counts as stale (defaults 3 and 35).
LEDGR_STALE_AFTER_DAYS=
LEDGR_CA_MAX_AGE_DAYS=

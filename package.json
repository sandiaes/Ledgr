{
  "name": "ledgr",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "importer": "tsx scripts/import/src/main.ts",
    "prices": "tsx scripts/prices/src/main.ts",
    "functions:build": "esbuild packages/market/src/edge.ts --bundle --format=esm --platform=neutral --main-fields=module,main --target=es2022 --legal-comments=none --outfile=supabase/functions/_shared/ledgr-jobs.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "2.1.9",
    "esbuild": "0.25.10",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
